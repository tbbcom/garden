{
 "rules": [
  {
   "from": "/search/label/:label",
   "to": "/category/:label/",
   "note": "label pages → category pages (slugged)"
  },
  {
   "from": "/search",
   "to": "/search/",
   "note": "site search, query string kept"
  },
  {
   "from": "/feeds/posts/default",
   "to": "/feed.xml",
   "note": "Atom/RSS feed, any ?alt="
  },
  {
   "from": "/feeds/*",
   "to": "/feed.xml",
   "note": "all other Blogger feeds"
  },
  {
   "from": "/atom.xml",
   "to": "/feed.xml"
  },
  {
   "from": "/rss.xml",
   "to": "/feed.xml"
  },
  {
   "from": "/sitemap-pages.xml",
   "to": "/sitemap.xml"
  },
  {
   "from": "/:yyyy/",
   "to": "/",
   "note": "year archive (4 digits)"
  },
  {
   "from": "/:yyyy/:mm/",
   "to": "/",
   "note": "month archive"
  },
  {
   "from": "*?m=1 / ?m=0",
   "to": "same path without ?m=",
   "note": "Blogger mobile parameter"
  }
 ],
